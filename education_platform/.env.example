APP_ENV=development
APP_TITLE='Онлайн Школа'
APP_DEBUG=true
API_PREFIX=/api

# Database
# PostgreSQL:
DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/<database_name>
# SQLite (Local file alternative):
# DATABASE_URL=sqlite+aiosqlite:///./fastapi_education.db
DATABASE_ECHO=false

# Docker Compose variables (PostgreSQL)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=education_db
POSTGRES_PORT=5432

# Security / JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (Cache & Queue)
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
SUBMISSION_QUEUE_NAME=code-submissions
CONTENT_CACHE_TTL_SECONDS=300

# S3 / MinIO Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=course-covers
